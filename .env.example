# VENORA AI - Environment Configuration Example
# Copy this file to .env for local development overrides.
# Defaults are already configured for safe local execution without .env.

# Application Information
APP_NAME="VENORA AI"
APP_VERSION="0.3.0"
ENVIRONMENT="development"
DEBUG=true

# Server Networking
HOST="127.0.0.1"
PORT=8000
API_V1_PREFIX="/api/v1"

# Database Configuration (Relative to project root or absolute path)
# Default is SQLite database stored in data/venora.db
DATABASE_URL="sqlite:///./data/venora.db"

# Logging Configuration
LOG_LEVEL="INFO"
LOG_DIR="./logs"
LOG_FILE_NAME="venora.log"
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Security & Network Controls
# Comma-separated list of allowed origins. Do not use "*" in production.
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173"
MAX_REQUEST_SIZE_BYTES=1048576

# Phase 2: Desktop Controls
DESKTOP_AUTOMATION_ENABLED=true
DESKTOP_INPUT_AUTOMATION_ENABLED=false
DESKTOP_EMERGENCY_STOP_ACTIVE=false
SCREENSHOT_DIR="./data/screenshots"
MAX_SCREENSHOT_BYTES=5242880
ACTION_TIMEOUT_SECONDS=10.0
LAUNCH_TIMEOUT_SECONDS=5.0
MAX_TYPE_TEXT_LENGTH=250

# Phase 3: AI Reasoning & OpenRouter Provider Configuration
# Set your OpenRouter API key here (leave blank or unset for offline mode):
OPENROUTER_API_KEY=""
VENORA_AI_MODEL="anthropic/claude-3.5-sonnet"
VENORA_AI_BASE_URL="https://openrouter.ai/api/v1"
VENORA_AI_TIMEOUT_SECONDS=60.0
VENORA_AI_MAX_RETRIES=2
MAX_TOOL_CALL_ROUNDS=3
MAX_USER_MESSAGE_CHARS=4000

# Phase 7: Long-Term Memory & Retrieval Configuration
VENORA_MEMORY_ENABLED=true
VENORA_MEMORY_AUTO_EXTRACT=true
VENORA_MEMORY_MAX_ITEMS=10000
VENORA_MEMORY_MAX_RETRIEVED=8
VENORA_MEMORY_MIN_RELEVANCE=0.25
VENORA_MEMORY_MAX_CONTEXT_CHARS=8000
VENORA_MEMORY_MAX_CANDIDATES_PER_CONVERSATION=10
VENORA_MEMORY_MIN_CONFIDENCE=0.75
VENORA_MEMORY_DEFAULT_TTL_DAYS=30
VENORA_MEMORY_EMBEDDING_PROVIDER=""
VENORA_MEMORY_EMBEDDING_MODEL=""
VENORA_MEMORY_EXTRACTION_TIMEOUT_SECONDS=30.0
VENORA_MEMORY_SEARCH_TIMEOUT_SECONDS=5.0
